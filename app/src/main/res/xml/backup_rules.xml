<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde automatique Android (ancien format, ignoré à partir d'Android 12 au profit de data_extraction_rules.xml).
   Exclus : les secrets chiffrés (clé API, en-têtes) — leur clé de chiffrement reste dans le Keystore de l'appareil,
   ils seraient illisibles après restauration — et la copie locale des liens, propre au compte.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="karabau_secure.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    <exclude domain="file" path="datastore/karabau_settings.preferences_pb" />
</full-backup-content>
