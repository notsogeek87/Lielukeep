<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde cloud et transfert d'appareil (Android 12+). Exclus : les secrets chiffrés (clé API, en-têtes), illisibles
   ailleurs car leur clé reste dans le Keystore de l'appareil, et les réglages liés au compte. Après restauration,
   il suffit de se reconnecter. La copie locale des liens (cache) n'est jamais sauvegardée par Android.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="karabau_secure.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="file" path="datastore/karabau_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="karabau_secure.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="file" path="datastore/karabau_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
